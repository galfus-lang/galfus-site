DEFINE TABLE account_authenticator SCHEMAFULL COMMENT 'Persistent primary, multi-factor, or recovery authenticator owned by a global account.';
DEFINE FIELD account ON account_authenticator TYPE record<account>;
DEFINE FIELD identity ON account_authenticator TYPE option<record<account_identity>>;
DEFINE FIELD kind ON account_authenticator TYPE string ASSERT $value IN ['password', 'passkey', 'totp', 'email_otp', 'sms_otp', 'recovery_code'];
DEFINE FIELD purpose ON account_authenticator TYPE string ASSERT $value IN ['primary', 'mfa', 'recovery'];
DEFINE FIELD status ON account_authenticator TYPE string DEFAULT 'pending' ASSERT $value IN ['pending', 'active', 'disabled'];
DEFINE FIELD identifier ON account_authenticator TYPE option<string>;
DEFINE FIELD secret_hash ON account_authenticator TYPE option<string>;
DEFINE FIELD secret_ciphertext ON account_authenticator TYPE option<string>;
DEFINE FIELD public_key ON account_authenticator TYPE option<string>;
DEFINE FIELD metadata ON account_authenticator TYPE object DEFAULT {};
DEFINE FIELD metadata.webauthn_user_id ON account_authenticator TYPE option<string>;
DEFINE FIELD metadata.counter ON account_authenticator TYPE option<int>;
DEFINE FIELD metadata.transports ON account_authenticator TYPE option<array<string>>;
DEFINE FIELD metadata.device_type ON account_authenticator TYPE option<string>;
DEFINE FIELD metadata.backed_up ON account_authenticator TYPE option<bool>;
DEFINE FIELD metadata.label ON account_authenticator TYPE option<string>;
DEFINE FIELD metadata.last_used_at ON account_authenticator TYPE option<datetime>;
DEFINE FIELD verified_at ON account_authenticator TYPE option<datetime>;
DEFINE FIELD disabled_at ON account_authenticator TYPE option<datetime>;
DEFINE FIELD expires_at ON account_authenticator TYPE option<datetime>;
DEFINE FIELD created_at ON account_authenticator TYPE datetime DEFAULT time::now() READONLY;
DEFINE FIELD updated_at ON account_authenticator TYPE datetime VALUE time::now();
DEFINE INDEX idx_account_authenticator_account_purpose_status ON account_authenticator COLUMNS account, purpose, status;
DEFINE INDEX idx_account_authenticator_identifier ON account_authenticator COLUMNS identifier UNIQUE;

DEFINE TABLE account_identity SCHEMAFULL COMMENT 'Unique local or external login identity linked to a global account. Identifier is the normalized local value or the immutable provider subject.';
DEFINE FIELD kind ON account_identity TYPE string DEFAULT 'local' ASSERT $value IN ['local', 'external'];
DEFINE FIELD provider ON account_identity TYPE string ASSERT $value IN ['email', 'username', 'google', 'github', 'steam'];
DEFINE FIELD issuer ON account_identity TYPE string DEFAULT 'galfus';
DEFINE FIELD identifier ON account_identity TYPE string;
DEFINE FIELD account ON account_identity TYPE record<account>;
DEFINE FIELD status ON account_identity TYPE string DEFAULT 'active' ASSERT $value IN ['pending', 'active', 'disabled'];
DEFINE FIELD verified_at ON account_identity TYPE option<datetime>;
DEFINE FIELD disabled_at ON account_identity TYPE option<datetime>;
DEFINE FIELD metadata ON account_identity TYPE object FLEXIBLE DEFAULT {};
DEFINE FIELD created_at ON account_identity TYPE datetime DEFAULT time::now() READONLY;
DEFINE FIELD updated_at ON account_identity TYPE datetime VALUE time::now();
DEFINE INDEX idx_provider_issuer_identifier ON account_identity COLUMNS provider, issuer, identifier UNIQUE;
DEFINE INDEX idx_account_identity_account_kind_provider_status ON account_identity COLUMNS account, kind, provider, status;

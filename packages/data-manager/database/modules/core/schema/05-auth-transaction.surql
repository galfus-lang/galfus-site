DEFINE TABLE auth_transaction SCHEMAFULL;
DEFINE FIELD intent ON auth_transaction TYPE string ASSERT $value IN ['login', 'register', 'invite', 'recovery', 'upsert_password'];
DEFINE FIELD status ON auth_transaction TYPE string DEFAULT 'pending' ASSERT $value IN ['pending', 'awaiting_sso', 'awaiting_primary', 'awaiting_mfa', 'authorized', 'completed', 'failed', 'expired'];
DEFINE FIELD account ON auth_transaction TYPE option<record<account>>;
DEFINE FIELD organization ON auth_transaction TYPE option<record<organization>>;
DEFINE FIELD invitation ON auth_transaction TYPE option<record<organization_invitation>>;
DEFINE FIELD ssoConnection ON auth_transaction TYPE option<record<organization_sso_connection>>;
DEFINE FIELD returnTo ON auth_transaction TYPE option<string>;
DEFINE FIELD browserVerifierHash ON auth_transaction TYPE string;
DEFINE FIELD primaryMethod ON auth_transaction TYPE option<string>;
DEFINE FIELD pendingMfaMethod ON auth_transaction TYPE option<string>;
DEFINE FIELD oidcStateHash ON auth_transaction TYPE option<string>;
DEFINE FIELD oidcNonceHash ON auth_transaction TYPE option<string>;
DEFINE FIELD pkceVerifierCiphertext ON auth_transaction TYPE option<string>;
DEFINE FIELD attempts ON auth_transaction TYPE int DEFAULT 0;
DEFINE FIELD maxAttempts ON auth_transaction TYPE int DEFAULT 5;
DEFINE FIELD expiresAt ON auth_transaction TYPE datetime;
DEFINE FIELD consumedAt ON auth_transaction TYPE option<datetime>;
DEFINE FIELD version ON auth_transaction TYPE int DEFAULT 0;
DEFINE FIELD createdAt ON auth_transaction TYPE datetime DEFAULT time::now() READONLY;
DEFINE FIELD updatedAt ON auth_transaction TYPE datetime VALUE time::now();
DEFINE INDEX idx_auth_transaction_expires_at ON auth_transaction COLUMNS expiresAt;

DEFINE TABLE belongs_to SCHEMAFULL TYPE RELATION IN account OUT organization COMMENT 'Membership relation between a global account and an organization, including access lifecycle and origin.';
DEFINE FIELD role ON belongs_to TYPE string DEFAULT 'member';
DEFINE FIELD status ON belongs_to TYPE string DEFAULT 'active' ASSERT $value IN ['pending_activation', 'pending_sso', 'active', 'revoked', 'disabled'];
DEFINE FIELD origin ON belongs_to TYPE string DEFAULT 'manual' ASSERT $value IN ['self', 'invite', 'sso', 'manual'];
DEFINE FIELD grant_transaction ON belongs_to TYPE option<record<auth_transaction>>;
DEFINE FIELD sso_connection ON belongs_to TYPE option<record<organization_sso_connection>>;
DEFINE FIELD federated_subject ON belongs_to TYPE option<string>;
DEFINE FIELD federated_metadata ON belongs_to TYPE option<object> FLEXIBLE;
DEFINE FIELD sso_required_at ON belongs_to TYPE option<datetime>;
DEFINE FIELD sso_verified_at ON belongs_to TYPE option<datetime>;
DEFINE FIELD sso_last_verified_at ON belongs_to TYPE option<datetime>;
DEFINE FIELD activated_at ON belongs_to TYPE option<datetime>;
DEFINE FIELD revoked_at ON belongs_to TYPE option<datetime>;
DEFINE FIELD revoked_reason ON belongs_to TYPE option<string>;
DEFINE FIELD joined_at ON belongs_to TYPE datetime DEFAULT time::now() READONLY;
DEFINE INDEX idx_belongs_to_account_organization ON belongs_to COLUMNS in, out UNIQUE;
DEFINE INDEX idx_belongs_to_account_status ON belongs_to COLUMNS in, status;
DEFINE INDEX idx_belongs_to_organization_status ON belongs_to COLUMNS out, status;
DEFINE INDEX idx_belongs_to_account_sso_connection ON belongs_to COLUMNS in, sso_connection;
DEFINE INDEX idx_belongs_to_sso_subject ON belongs_to COLUMNS sso_connection, federated_subject UNIQUE;

{
  "name": "@galfus/data-manager",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "local:check": "bun run scripts/surrealkit.ts local sync --dry-run",
    "local:sync": "bun run scripts/surrealkit.ts local sync",
    "local:typegen": "bun run scripts/surrealkit.ts local typegen",
    "dev:check": "bun run scripts/surrealkit.ts development sync --dry-run",
    "dev:sync": "bun run scripts/surrealkit.ts development sync --allow-shared-prune",
    "dev:typegen": "bun run scripts/surrealkit.ts development typegen",
    "prod:check": "bun run scripts/surrealkit.ts production sync --dry-run",
    "prod:sync": "bun run scripts/surrealkit.ts production sync --allow-shared-prune",
    "prod:typegen": "bun run scripts/surrealkit.ts production typegen",
    "auth:clear:local:check": "bun run scripts/clear-auth-data.ts local --dry-run",
    "auth:clear:local": "bun run scripts/clear-auth-data.ts local",
    "auth:clear:development:check": "bun run scripts/clear-auth-data.ts development --dry-run",
    "auth:clear:development": "bun run scripts/clear-auth-data.ts development",
    "auth:clear:production:check": "bun run scripts/clear-auth-data.ts production --dry-run",
    "auth:clear:production": "bun run scripts/clear-auth-data.ts production"
  },
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/index.ts",
    "./server": "./src/server.ts"
  },
  "dependencies": {
    "@galfus/i18n": "workspace:*",
    "surrealdb": "^2.0.9",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  }
}

{
  "name": "@galfus/design-system",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./components/*": {
      "svelte": "./src/lib/components/*",
      "default": "./src/lib/components/*"
    },
    "./styles/*": "./src/lib/styles/*",
    "./utils/*": "./src/lib/utils/*.ts",
    "./seo/*": {
      "svelte": "./src/lib/seo/*",
      "default": "./src/lib/seo/*"
    }
  },
  "svelte": "./src/lib/index.ts",
  "scripts": {
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@galfus/assets": "workspace:*",
    "@galfus/auth-utils": "workspace:*",
    "@iconify-json/lucide": "^1.2.138",
    "@iconify-json/simple-icons": "^1.2.98",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  }
}

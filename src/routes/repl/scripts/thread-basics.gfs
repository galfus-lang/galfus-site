import { println } from "std/io"
import { createThread } from "std/thread"

fn worker(_args: [[u8]]): i32 {
  println("Hello from the background thread!")
  return 0
}

export fn main(_args: [[u8]]): i32 {
  println("Main thread starting...")
  
  const thread = createThread(worker, "my-worker")
  if thread::spawn() {
    println("Worker thread spawned successfully.")
  } else {
    println("Failed to spawn thread.")
  }
  
  return 0
}

{
  "name": "galfus-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --bun run -F '*' dev",
    "build": "bun run -F '*' build",
    "db:local:check": "bun run -F '@galfus/data-manager' local:check",
    "db:local:sync": "bun run -F '@galfus/data-manager' local:sync",
    "db:local:typegen": "bun run -F '@galfus/data-manager' local:typegen",
    "db:dev:check": "bun run -F '@galfus/data-manager' dev:check",
    "db:dev:sync": "bun run -F '@galfus/data-manager' dev:sync",
    "db:dev:typegen": "bun run -F '@galfus/data-manager' dev:typegen",
    "db:prod:check": "bun run -F '@galfus/data-manager' prod:check",
    "db:prod:sync": "bun run -F '@galfus/data-manager' prod:sync",
    "db:prod:typegen": "bun run -F '@galfus/data-manager' prod:typegen",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}

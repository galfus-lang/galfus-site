# SurrealDB connection
SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_NS=development
SURREAL_DB=main
SURREAL_USER=root
SURREAL_PASS=root

# JWT signing secret and key identifier.
# Generate a unique, random secret of at least 32 characters for each environment.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_JWT_KEY_ID=local-v1

# Resend credentials and sender on a verified domain.
RESEND_API_KEY=re_00000000_000000000000000000000000
RESEND_FROM="Fusy <bot@galfus.com>"

# Independent secret used to hash short-lived verification codes.
AUTH_OTP_SECRET=replace-with-a-long-random-secret

# AES-256 key encoded as base64url and independent recovery-code pepper.
AUTH_TOTP_KEY=replace-with-a-long-random-secret
AUTH_RECOVERY_PEPPER=replace-with-a-long-random-secret
AUTH_RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# Optional WebAuthn origin and relying-party ID. The defaults are localhost:5001
# locally and auth.galfus.com / galfus.com in production.
# AUTH_PASSKEY_ORIGIN=http://localhost:5001
# AUTH_PASSKEY_RP_ID=localhost

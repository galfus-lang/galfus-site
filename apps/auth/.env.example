# JWT signing secret and key identifier.
# Generate a unique, strong secret for each environment.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_JWT_KEY_ID=local-v1

# Resend credentials and sender on a verified domain.
RESEND_API_KEY=
RESEND_FROM="Fusy <bot@galfus.com>"

# Independent secret used to hash short-lived verification codes.
AUTH_OTP_SECRET=

# Passkey relying-party settings are currently hardcoded in
# src/lib/server/passkey.ts: localhost for development and galfus.com for production.
# The app does not read passkey settings from environment variables yet.

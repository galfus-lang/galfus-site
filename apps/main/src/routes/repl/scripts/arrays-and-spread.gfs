import { println } from "std/io"
import { stringify } from "format"

export fn main(_args: [[u8]]): i32 {
  const first = [1, 2, 3]
  const combined = [...first, 4, 5]
  
  println("Combined array length:")
  
  // A simple loop to sum the array and demonstrate elements
  var total = 0
  for item in combined {
    total += item
  }
  
  println("Total sum of elements:")
  println(stringify(total))
  
  return 0
}
